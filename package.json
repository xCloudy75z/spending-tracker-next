{
  "name": "spending-tracker-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node tools/serve.mjs --root site --port 4173",
    "validate:site": "node tools/validate-public-site.mjs site",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:site": "node --test \"tests/site/**/*.test.js\"",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:site",
    "icons": "node tools/generate-icons.mjs",
    "verify": "npm test && npm run validate:site"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
